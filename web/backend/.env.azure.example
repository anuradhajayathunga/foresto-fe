# ─────────────────────────────────────────────
# Backend Azure Environment Variables Example
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# Django core
SECRET_KEY=your-strong-production-secret-key-here
DEBUG=0

# Azure App Service sets the hostname automatically; add your custom domain too
ALLOWED_HOSTS=your-app-name.azurewebsites.net,your-custom-domain.com

# PostgreSQL (Azure Database for PostgreSQL – Flexible Server)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL=postgresql://foresto_user:foresto_password@your-db-server.postgres.database.azure.com:5432/foresto_db?sslmode=require

# CORS — set to your frontend origin (Azure Static Web Apps URL or App Service URL)
CORS_ALLOWED_ORIGINS=https://your-frontend.azurestaticapps.net,https://your-custom-domain.com
CSRF_TRUSTED_ORIGINS=https://your-app-name.azurewebsites.net,https://your-custom-domain.com

# JWT
JWT_ACCESS_LIFETIME_MIN=60
JWT_REFRESH_LIFETIME_DAYS=7

# WhatsApp Cloud API (optional)
WHATSAPP_ENABLED=false
WHATSAPP_API_BASE=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_DEFAULT_COUNTRY_CODE=

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=your-email@gmail.com
PURCHASE_EMAIL_FROM=your-email@gmail.com
PURCHASE_AUTO_EMAIL_ON_CREATE=True
